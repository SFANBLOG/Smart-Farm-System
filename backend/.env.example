# ===== 数据库 =====
# 默认 MySQL 8（需本地已安装并启动 MySQL，且已创建库 smart_farm）
DB_URL=mysql://root:123456@127.0.0.1:3306/smart_farm
# 无 MySQL 时可改用 SQLite 跑通全流程演示（与文章"断网/无环境也能跑"一致）：
# DB_URL=sqlite://data/farm.db

# ===== 安全 =====
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== AI 引擎 =====
# offline = 等价状态机（默认，无需任何依赖即可跑通）；langgraph = LangGraph StateGraph 编排
ENGINE_MODE=offline

# ===== 大模型（默认关闭=离线兜底）=====
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===== 气象 / 并发 / RAG =====
WEATHER_DEFAULT_LAT=28.2
WEATHER_DEFAULT_LON=112.9
WEATHER_CACHE_TTL=600
SCAN_CONCURRENCY=3
RAG_TOP_K=4
